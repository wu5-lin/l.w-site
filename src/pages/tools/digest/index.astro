---
import Base from '../../../layouts/Base.astro';
import { inlineScriptCsp } from '../../../lib/theme-client';

const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "img-src 'self' data:",
  "style-src 'self'",
  "font-src 'self'",
  `script-src 'self' ${inlineScriptCsp}`,
  "connect-src 'self'",
  "form-action 'self'",
].join('; ');
---

<Base title="资讯简报" description="每天自动收一轮公开的投资、科研、web3 与科技来源，给自己看。">
  <meta slot="head" http-equiv="Content-Security-Policy" content={csp} />
  <link slot="head" rel="stylesheet" href="/tools/digest/styles.css" />
  <div class="digest">
    <h1>资讯简报</h1>
    <p class="lead">每天把公开来源收成一页。投资、科研、web3、科技，可以按地区和关键词筛。</p>
    <div class="controls">
      <div class="ctl">
        <span class="ctl-label">类别</span>
        <div class="seg" id="catSeg">
          <button type="button" data-cat="全部" class="active">全部</button>
          <button type="button" data-cat="投资">投资</button>
          <button type="button" data-cat="科研">科研</button>
          <button type="button" data-cat="web3">web3</button>
          <button type="button" data-cat="科技">科技</button>
        </div>
      </div>
      <div class="ctl">
        <span class="ctl-label">地区</span>
        <div class="seg" id="regionSeg">
          <button type="button" data-region="全部" class="active">全部</button>
          <button type="button" data-region="cn">国内</button>
          <button type="button" data-region="en">国际</button>
        </div>
      </div>
      <div class="search">
        <input type="text" id="q" placeholder="搜索标题 / 摘要 / 来源" aria-label="搜索简报" />
      </div>
    </div>
    <p class="meta" id="meta">加载中…</p>
    <div class="news-grid" id="grid"></div>
    <div class="empty" id="empty" hidden>
      暂无数据。<br />简报由 GitHub Actions 每天（北京时间 09:00）写入 digest.json，构建网站时带上。
    </div>
  </div>
  <script is:inline src="/tools/digest/app.js"></script>
</Base>
