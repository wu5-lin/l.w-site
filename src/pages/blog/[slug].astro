---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPostsForPaths, isoDate, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForPaths();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: i > 0 ? posts[i - 1] : null,
      nextPost: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tocOpenLimit = 5;
const minutes = readingMinutes(post.body ?? post.data.summary);
---

<Base title={post.data.title} description={post.data.summary} ogType="article">
  <article class="article">
    <a class="back" href="/">← 首页</a>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <span class="meta-dot" aria-hidden="true"></span>
      <span>约 {minutes} 分钟</span>
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    </div>
    {toc.length >= 2 && (
      <details class="toc" open={toc.length <= tocOpenLimit}>
        <summary>目录</summary>
        <ol>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'toc-sub' : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    {(prevPost || nextPost) && (
      <nav class="post-nav" aria-label="文章导航">
        {prevPost && (
          <a href={`/blog/${prevPost.id}/`}>
            <span>← 较新一篇</span>
            <strong>{prevPost.data.title}</strong>
          </a>
        )}
        {nextPost && (
          <a class="post-nav-next" href={`/blog/${nextPost.id}/`}>
            <span>较早一篇 →</span>
            <strong>{nextPost.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
  <div class="copy-live" id="copy-live" role="status"></div>
  <dialog class="lightbox" id="lightbox" aria-label="图片放大预览">
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-bar">
      <span id="lightbox-cap"></span>
      <button class="lightbox-close" id="lightbox-close" type="button">关闭</button>
    </div>
  </dialog>
  <script is:inline>
    (function () {
      var prose = document.querySelector('.prose');
      if (!prose) return;

      prose.querySelectorAll('pre').forEach(function (pre) {
        var wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.addEventListener('click', function () {
          var code = pre.querySelector('code');
          var text = (code ? code.innerText : pre.innerText) || '';
          function finish(ok) {
            btn.textContent = ok ? '已复制' : '复制失败';
            btn.classList.toggle('is-error', !ok);
            var live = document.getElementById('copy-live');
            if (live) {
              live.textContent = '';
              setTimeout(function () { live.textContent = ok ? '已复制' : '复制失败'; }, 30);
            }
            clearTimeout(btn._reset);
            btn._reset = setTimeout(function () {
              btn.textContent = '复制';
              btn.classList.remove('is-error');
            }, ok ? 1600 : 2200);
          }
          function legacyCopy() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '0';
            ta.style.left = '0';
            ta.style.width = '1px';
            ta.style.height = '1px';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            var ok = false;
            try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
            document.body.removeChild(ta);
            btn.focus();
            return ok;
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () { finish(true); }).catch(function () {
              finish(legacyCopy());
            });
            return;
          }
          finish(legacyCopy());
        });
        wrap.appendChild(btn);
      });

      var dialog = document.getElementById('lightbox');
      var imgEl = document.getElementById('lightbox-img');
      var capEl = document.getElementById('lightbox-cap');
      var closeBtn = document.getElementById('lightbox-close');
      if (dialog && imgEl && typeof dialog.showModal === 'function') {
        var lastFocus = null;
        function openFrom(img) {
          lastFocus = img;
          imgEl.src = img.currentSrc || img.src;
          imgEl.alt = img.alt || '';
          if (capEl) capEl.textContent = img.alt || '';
          dialog.showModal();
        }
        prose.querySelectorAll('img').forEach(function (img) {
          img.addEventListener('click', function () { openFrom(img); });
          if (img.closest('a, button')) return;
          img.tabIndex = 0;
          img.setAttribute('role', 'button');
          img.setAttribute('aria-haspopup', 'dialog');
          img.setAttribute('aria-controls', 'lightbox');
          img.setAttribute('aria-label', (img.getAttribute('alt') || '图片') + '，放大查看');
          img.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            openFrom(img);
          });
        });
        if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) dialog.close();
        });
        dialog.addEventListener('close', function () {
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        });
      }
    })();
  </script>
</Base>
