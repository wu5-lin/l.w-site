---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, isoDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary} ogType="article">
  <article class="article">
    <a class="back" href="/">← 首页</a>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
