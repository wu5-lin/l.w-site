---
import Base from '../../layouts/Base.astro';
import { tags } from '../../lib/tags';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map(tags.map((tag) => [tag, posts.filter((post) => post.data.tags.includes(tag)).length]));
---

<Base title="标签" description="文章标签">
  <section class="page">
    <a class="back" href="/">← 首页</a>
    <h1>标签</h1>
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag)}/`}>
            {tag}
            <span>{counts.get(tag) ?? 0} 篇</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
