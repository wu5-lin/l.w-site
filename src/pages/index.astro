---
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, isoDate } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <link slot="head" rel="preload" as="image" href="/avatar.webp" type="image/webp" />
  <section class="stage hero-stage">
    <div class="blobs" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <div class="stage-content">
      <div class="glass hero-card">
        <div class="rise">
          <img
            class="avatar"
            src="/avatar.webp"
            width="112"
            height="112"
            alt="像素画：一只小狗抱着太阳"
          />
          <h1>lw</h1>
          <p class="tagline">Stay hungry, stay foolish.</p>
          <div class="social">
            <a href="https://github.com/wu5-lin" rel="me noreferrer" target="_blank" aria-label="GitHub">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.47c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            </a>
            <a href="https://x.com/JayLynn_lw" rel="me noreferrer" target="_blank" aria-label="X">
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M9.33 6.77 14.7.5h-1.27L8.77 5.89 5.08.5H.5l5.64 8.21L.5 15.5h1.27l4.93-5.74 3.94 5.74H15.5L9.33 6.77Zm-1.75 2.03-.57-.82L2.3 1.47h1.95l3.66 5.24.57.82 4.76 6.81H11.3L7.58 8.8Z"/></svg>
            </a>
            <a href="mailto:hello@l-w.sryze.cc" aria-label="邮箱 hello@l-w.sryze.cc">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="posts" aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="posts-label">最近</h2>
    <ol class="post-list">
      {posts.map((post, i) => (
        <li>
          <a class:list={['post', 'rise', i === 1 && 'd1', i === 2 && 'd2']} href={`/blog/${post.id}/`}>
            <h3>{post.data.title}</h3>
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <p>{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
